# Configuración de Supabase para el Portafolio Web
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Variables de Identificación de Entorno (Inyectadas automáticamente en Vercel)
# En Vercel no es necesario configurarlas manualmente en el dashboard,
# ya que vite.config.js las expone automáticamente durante la compilación:
# VERCEL_ENV: "production" | "preview" | "development"
# VERCEL_GIT_COMMIT_REF: "master" | "develop" | "feature/xyz"
# VERCEL_GIT_COMMIT_SHA: "hash_corto_del_commit"
